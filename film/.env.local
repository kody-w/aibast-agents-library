# Local film credentials. GITIGNORED — never commit this file.
# This repo is a fork of a public Microsoft repo; the resource id contains a
# subscription GUID and must not land in git.
#
#   source film/.env.local
#
# The TOKEN is deliberately not stored: Entra tokens expire in ~1 hour, so a
# saved one is a stale secret rather than a convenience. It is minted fresh
# below each time you source this file.

export FILM_SPEECH_RESOURCE_ID="/subscriptions/14d18b0c-2dd3-4e69-a8bf-641d32368046/resourceGroups/koda-ai/providers/Microsoft.CognitiveServices/accounts/koda-speech"
export AZURE_SPEECH_RESOURCE_ID="$FILM_SPEECH_RESOURCE_ID"
export FILM_SPEECH_VOICE="en-US-AndrewMultilingualNeural"
export AZURE_SPEECH_TOKEN="$(az account get-access-token --resource https://cognitiveservices.azure.com --query accessToken -o tsv 2>/dev/null)"
if [ -z "$AZURE_SPEECH_TOKEN" ]; then
  echo "[film] az token mint FAILED — run 'az login' first. Do NOT build; you will get a robotic film." >&2
else
  echo "[film] Azure Speech ready · voice $FILM_SPEECH_VOICE"
fi
