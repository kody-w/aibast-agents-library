{
  "schema": "aibast-studio-data/1.0",
  "solution": "emission-tracking",
  "description": "The workshop's synthetic records as SharePoint lists: the same records the portable agent and the knowledge file hold, one list per record set. Every value is fictional.",
  "source": "agents/@aibast-agents-library/energy_stacks/emission_tracking_stack/emission_tracking_agent.py",
  "records_markdown": "solutions/emission-tracking/manual/knowledge/emission-tracking-synthetic-records.md",
  "lists": [
    {
      "id": "facilities",
      "title": "Emissions Facilities",
      "description": "Synthetic facilities, their scope 1-3 emissions and thresholds (AIBAST Emissions Tracking workshop; fictional).",
      "record_set": "FACILITIES",
      "columns": [
        {"name": "Title", "label": "Facility", "from": "name", "type": "text"},
        {"name": "FacilityId", "label": "Facility ID", "from": "$key", "type": "text"},
        {"name": "Location", "label": "Location", "from": "location", "type": "text"},
        {"name": "FacilityType", "label": "Type", "from": "type", "type": "text"},
        {"name": "CapacityMW", "label": "Capacity (MW)", "from": "capacity_mw", "type": "number"},
        {"name": "Scope1CO2", "label": "Scope 1 CO2 (t)", "from": "emissions.scope_1.co2_tonnes", "type": "number"},
        {"name": "Scope1CH4", "label": "Scope 1 CH4 (t)", "from": "emissions.scope_1.ch4_tonnes", "type": "number"},
        {"name": "Scope1N2O", "label": "Scope 1 N2O (t)", "from": "emissions.scope_1.n2o_tonnes", "type": "number"},
        {"name": "Scope2CO2", "label": "Scope 2 CO2 (t)", "from": "emissions.scope_2.co2_tonnes", "type": "number"},
        {"name": "Scope2CH4", "label": "Scope 2 CH4 (t)", "from": "emissions.scope_2.ch4_tonnes", "type": "number"},
        {"name": "Scope2N2O", "label": "Scope 2 N2O (t)", "from": "emissions.scope_2.n2o_tonnes", "type": "number"},
        {"name": "Scope3CO2", "label": "Scope 3 CO2 (t)", "from": "emissions.scope_3.co2_tonnes", "type": "number"},
        {"name": "Scope3CH4", "label": "Scope 3 CH4 (t)", "from": "emissions.scope_3.ch4_tonnes", "type": "number"},
        {"name": "Scope3N2O", "label": "Scope 3 N2O (t)", "from": "emissions.scope_3.n2o_tonnes", "type": "number"},
        {"name": "ThresholdCO2", "label": "Regulatory threshold CO2 (t)", "from": "regulatory_threshold_co2", "type": "number"},
        {"name": "ReductionTargetPct", "label": "Reduction target (%)", "from": "reduction_target_pct", "type": "number"},
        {"name": "BaselineYear", "label": "Baseline year", "from": "baseline_year", "type": "text"},
        {"name": "BaselineCO2", "label": "Baseline CO2 (t)", "from": "baseline_co2", "type": "number"}
      ]
    },
    {
      "id": "carbon-offsets",
      "title": "Emissions Carbon Offsets",
      "description": "Synthetic carbon offset projects and available credits (AIBAST Emissions Tracking workshop; fictional).",
      "record_set": "CARBON_OFFSETS",
      "columns": [
        {"name": "Title", "label": "Project", "from": "project", "type": "text"},
        {"name": "OffsetId", "label": "Offset ID", "from": "$key", "type": "text"},
        {"name": "OffsetType", "label": "Type", "from": "type", "type": "text"},
        {"name": "CreditsAvailable", "label": "Credits available (t)", "from": "credits_available", "type": "number"},
        {"name": "PricePerTonne", "label": "Price per tonne ($)", "from": "price_per_tonne", "type": "number"},
        {"name": "Vintage", "label": "Vintage", "from": "vintage", "type": "text"},
        {"name": "VerifiedBy", "label": "Verified by", "from": "verified_by", "type": "text"}
      ]
    },
    {
      "id": "regulations",
      "title": "Emissions Regulations",
      "description": "Synthetic reporting programs, thresholds and deadlines (AIBAST Emissions Tracking workshop; fictional).",
      "record_set": "REGULATIONS",
      "columns": [
        {"name": "Title", "label": "Program", "from": "name", "type": "text"},
        {"name": "RegulationId", "label": "Regulation ID", "from": "$key", "type": "text"},
        {"name": "ThresholdCO2", "label": "Reporting threshold CO2 (t)", "from": "threshold_co2", "type": "number"},
        {"name": "Deadline", "label": "Deadline", "from": "deadline", "type": "text"}
      ]
    }
  ]
}
