    },
    {
      "id": "active-stages",
      "title": "Deal Progression Active Stages",
      "description": "Synthetic active stages (AIBAST Deal Progression workshop; fictional).",
      "record_set": "_ACTIVE_STAGES",
      "columns": [
        {"name": "Title", "label": "Active Stage", "from": "$value", "type": "text"},
        {"name": "ActiveStageId", "label": "Active Stage ID", "from": "$key", "type": "text"}
      ]
    }
