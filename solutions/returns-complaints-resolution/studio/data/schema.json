{
  "schema": "aibast-studio-data/1.0",
  "solution": "returns-complaints-resolution",
  "description": "The workshop's synthetic records as SharePoint lists: the same records the portable agent and the knowledge file hold, one list per record set. Every value is fictional.",
  "source": "agents/@aibast-agents-library/retail_cpg_stacks/returns_complaints_resolution_stack/returns_complaints_resolution_agent.py",
  "records_markdown": "solutions/returns-complaints-resolution/manual/knowledge/aibast_returns-complaints-synthetic-records.md",
  "lists": [
    {
      "id": "return-requests",
      "title": "Returns and Complaints Resolution Return Requests",
      "description": "Synthetic return requests (AIBAST Returns and Complaints Resolution workshop; fictional).",
      "record_set": "RETURN_REQUESTS",
      "columns": [
        {"name": "Title", "label": "Return Request", "from": "case_label", "type": "text"},
        {"name": "ReturnRequestId", "label": "Return Request ID", "from": "$key", "type": "text"},
        {"name": "OrderID", "label": "Order ID", "from": "order_id", "type": "text"},
        {"name": "Product", "label": "Product", "from": "product", "type": "text"},
        {"name": "SKU", "label": "SKU", "from": "sku", "type": "text"},
        {"name": "PurchasePrice", "label": "Purchase Price", "from": "purchase_price", "type": "number"},
        {"name": "PurchaseDate", "label": "Purchase Date", "from": "purchase_date", "type": "text"},
        {"name": "RequestDate", "label": "Request Date", "from": "request_date", "type": "text"},
        {"name": "Reason", "label": "Reason", "from": "reason", "type": "text"},
        {"name": "Condition", "label": "Condition", "from": "condition", "type": "text"},
        {"name": "Channel", "label": "Channel", "from": "channel", "type": "text"},
        {"name": "Status", "label": "Status", "from": "status", "type": "text"},
        {"name": "Notes", "label": "Notes", "from": "notes", "type": "text"}
      ]
    },
    {
      "id": "complaint-categories",
      "title": "Returns and Complaints Resolution Complaint Categories",
      "description": "Synthetic complaint categories (AIBAST Returns and Complaints Resolution workshop; fictional).",
      "record_set": "COMPLAINT_CATEGORIES",
      "columns": [
        {"name": "Title", "label": "Complaint Category", "from": "label", "type": "text"},
        {"name": "ComplaintCategoryId", "label": "Complaint Category ID", "from": "$key", "type": "text"},
        {"name": "SeverityWeight", "label": "Severity Weight", "from": "severity_weight", "type": "number"},
        {"name": "AvgResolutionHours", "label": "Avg Resolution Hours", "from": "avg_resolution_hours", "type": "number"},
        {"name": "EscalationRate", "label": "Escalation Rate", "from": "escalation_rate", "type": "number"},
        {"name": "Keywords", "label": "Keywords", "from": "keywords", "type": "text", "encoding": "joined"},
        {"name": "MonthlyVolume", "label": "Monthly Volume", "from": "monthly_volume", "type": "number"}
      ]
    },
    {
      "id": "resolution-playbooks",
      "title": "Returns and Complaints Resolution Resolution Playbooks",
      "description": "Synthetic resolution playbooks (AIBAST Returns and Complaints Resolution workshop; fictional).",
      "record_set": "RESOLUTION_PLAYBOOKS",
      "columns": [
        {"name": "Title", "label": "Resolution Playbook", "from": "label", "type": "text"},
        {"name": "ResolutionPlaybookId", "label": "Resolution Playbook ID", "from": "$key", "type": "text"},
        {"name": "ApplicableReasons", "label": "Applicable Reasons", "from": "applicable_reasons", "type": "text", "encoding": "joined"},
        {"name": "ApplicableConditions", "label": "Applicable Conditions", "from": "applicable_conditions", "type": "text", "encoding": "joined"},
        {"name": "MaxDaysSincePurchase", "label": "Max Days Since Purchase", "from": "max_days_since_purchase", "type": "number"},
        {"name": "CostImpact", "label": "Cost Impact", "from": "cost_impact", "type": "text"},
        {"name": "CsatImpact", "label": "Csat Impact", "from": "csat_impact", "type": "text"},
        {"name": "Steps", "label": "Steps", "from": "steps", "type": "text", "encoding": "joined"}
      ]
    },
    {
      "id": "trend-data",
      "title": "Returns and Complaints Resolution Trend Data",
      "description": "Synthetic trend data (AIBAST Returns and Complaints Resolution workshop; fictional).",
      "record_set": "TREND_DATA",
      "columns": [
        {"name": "Title", "label": "Trend Data", "from": "$key", "type": "text"},
        {"name": "TrendDataId", "label": "Trend Data ID", "from": "$key", "type": "text"},
        {"name": "Value", "label": "Value", "from": "$value", "type": "text", "encoding": "json"}
      ]
    }
  ]
}
