{
  "schema": "aibast-studio-data/1.0",
  "solution": "store-associate-copilot",
  "description": "The workshop's synthetic records as SharePoint lists: the same records the portable agent and the knowledge file hold, one list per record set. Every value is fictional.",
  "source": "agents/@aibast-agents-library/retail_cpg_stacks/store_associate_copilot_stack/store_associate_copilot_agent.py",
  "records_markdown": "solutions/store-associate-copilot/manual/knowledge/aibast_store-associate-synthetic-records.md",
  "lists": [
    {
      "id": "product-catalog",
      "title": "Retail Store Associate Copilot Product Catalog",
      "description": "Synthetic product catalog (AIBAST Retail Store Associate Copilot workshop; fictional).",
      "record_set": "PRODUCT_CATALOG",
      "columns": [
        {"name": "Title", "label": "Product Catalog", "from": "name", "type": "text"},
        {"name": "ProductCatalogId", "label": "Product Catalog ID", "from": "$key", "type": "text"},
        {"name": "Category", "label": "Category", "from": "category", "type": "text"},
        {"name": "Brand", "label": "Brand", "from": "brand", "type": "text"},
        {"name": "RetailPrice", "label": "Retail Price", "from": "retail_price", "type": "number"},
        {"name": "Sizes", "label": "Sizes", "from": "sizes", "type": "text", "encoding": "joined"},
        {"name": "Colors", "label": "Colors", "from": "colors", "type": "text", "encoding": "joined"},
        {"name": "Materials", "label": "Materials", "from": "materials", "type": "text"},
        {"name": "Care", "label": "Care", "from": "care", "type": "text"},
        {"name": "LocationAisle", "label": "Location Aisle", "from": "location_aisle", "type": "text"},
        {"name": "LocationShelf", "label": "Location Shelf", "from": "location_shelf", "type": "text"},
        {"name": "OnHand", "label": "On Hand", "from": "on_hand", "type": "number"},
        {"name": "Upc", "label": "Upc", "from": "upc", "type": "text"},
        {"name": "Features", "label": "Features", "from": "features", "type": "text", "encoding": "joined"}
      ]
    },
    {
      "id": "customer-interaction-scripts",
      "title": "Retail Store Associate Copilot Customer Interaction Scripts",
      "description": "Synthetic customer interaction scripts (AIBAST Retail Store Associate Copilot workshop; fictional).",
      "record_set": "CUSTOMER_INTERACTION_SCRIPTS",
      "columns": [
        {"name": "Title", "label": "Customer Interaction Script", "from": "$key", "type": "text"},
        {"name": "CustomerInteractionScriptId", "label": "Customer Interaction Script ID", "from": "$key", "type": "text"},
        {"name": "Scenario", "label": "Scenario", "from": "scenario", "type": "text"},
        {"name": "Script", "label": "Script", "from": "script", "type": "text"},
        {"name": "FollowUp", "label": "Follow Up", "from": "follow_up", "type": "text"},
        {"name": "Tips", "label": "Tips", "from": "tips", "type": "text", "encoding": "joined"}
      ]
    },
    {
      "id": "daily-task-list",
      "title": "Retail Store Associate Copilot Daily Task List",
      "description": "Synthetic daily task list (AIBAST Retail Store Associate Copilot workshop; fictional).",
      "record_set": "DAILY_TASK_LIST",
      "columns": [
        {"name": "Title", "label": "Daily Task List", "from": "$key", "type": "text"},
        {"name": "DailyTaskListId", "label": "Daily Task List ID", "from": "$key", "type": "text"},
        {"name": "Value", "label": "Value", "from": "$value", "type": "text", "encoding": "json"}
      ]
    },
    {
      "id": "associate-performance",
      "title": "Retail Store Associate Copilot Associate Performance",
      "description": "Synthetic associate performance (AIBAST Retail Store Associate Copilot workshop; fictional).",
      "record_set": "ASSOCIATE_PERFORMANCE",
      "columns": [
        {"name": "Title", "label": "Associate Performance", "from": "name", "type": "text"},
        {"name": "AssociatePerformanceId", "label": "Associate Performance ID", "from": "$key", "type": "text"},
        {"name": "Role", "label": "Role", "from": "role", "type": "text"},
        {"name": "Shift", "label": "Shift", "from": "shift", "type": "text"},
        {"name": "UnitsSoldToday", "label": "Units Sold Today", "from": "units_sold_today", "type": "number"},
        {"name": "RevenueToday", "label": "Revenue Today", "from": "revenue_today", "type": "number"},
        {"name": "TransactionsToday", "label": "Transactions Today", "from": "transactions_today", "type": "number"},
        {"name": "AvgBasket", "label": "Avg Basket", "from": "avg_basket", "type": "number"},
        {"name": "UpsellRate", "label": "Upsell Rate", "from": "upsell_rate", "type": "number"},
        {"name": "CsatScore", "label": "Csat Score", "from": "csat_score", "type": "number"},
        {"name": "TasksCompleted", "label": "Tasks Completed", "from": "tasks_completed", "type": "number"},
        {"name": "TasksTotal", "label": "Tasks Total", "from": "tasks_total", "type": "number"},
        {"name": "HoursThisWeek", "label": "Hours This Week", "from": "hours_this_week", "type": "number"}
      ]
    },
    {
      "id": "complementary-products",
      "title": "Retail Store Associate Copilot Complementary Products",
      "description": "Synthetic complementary products (AIBAST Retail Store Associate Copilot workshop; fictional).",
      "record_set": "COMPLEMENTARY_PRODUCTS",
      "columns": [
        {"name": "Title", "label": "Complementary Product", "from": "$key", "type": "text"},
        {"name": "ComplementaryProductId", "label": "Complementary Product ID", "from": "$key", "type": "text"},
        {"name": "Value", "label": "Value", "from": "$value", "type": "text", "encoding": "joined"}
      ]
    }
  ]
}
