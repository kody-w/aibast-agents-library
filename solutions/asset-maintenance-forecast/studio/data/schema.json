{
  "schema": "aibast-studio-data/1.0",
  "solution": "asset-maintenance-forecast",
  "description": "The workshop's synthetic records as SharePoint lists: the same records the portable agent and the knowledge file hold, one list per record set. Every value is fictional.",
  "source": "agents/@aibast-agents-library/energy_stacks/asset_maintenance_forecast_stack/asset_maintenance_forecast_agent.py",
  "records_markdown": "solutions/asset-maintenance-forecast/manual/knowledge/asset-maintenance-forecast-synthetic-records.md",
  "lists": [
    {
      "id": "assets",
      "title": "Asset Maintenance Forecast Assets",
      "description": "Synthetic assets (AIBAST Asset Maintenance Forecast workshop; fictional).",
      "record_set": "ASSETS",
      "columns": [
        {"name": "Title", "label": "Asset", "from": "name", "type": "text"},
        {"name": "AssetId", "label": "Asset ID", "from": "$key", "type": "text"},
        {"name": "Type", "label": "Type", "from": "type", "type": "text"},
        {"name": "Location", "label": "Location", "from": "location", "type": "text"},
        {"name": "InstalledYear", "label": "Installed Year", "from": "installed_year", "type": "text"},
        {"name": "AgeYears", "label": "Age Years", "from": "age_years", "type": "number"},
        {"name": "CapacityMW", "label": "Capacity MW", "from": "capacity_mw", "type": "number"},
        {"name": "ConditionScore", "label": "Condition Score", "from": "condition_score", "type": "number"},
        {"name": "LastMajorService", "label": "Last Major Service", "from": "last_major_service", "type": "text"},
        {"name": "OperatingHours", "label": "Operating Hours", "from": "operating_hours", "type": "number"},
        {"name": "FailureRateAnnualPct", "label": "Failure Rate Annual Pct", "from": "failure_rate_annual_pct", "type": "number"},
        {"name": "MaintenanceHistory", "label": "Maintenance History", "from": "maintenance_history", "type": "text", "encoding": "json"},
        {"name": "PredictedNextFailure", "label": "Predicted Next Failure", "from": "predicted_next_failure", "type": "text"},
        {"name": "ReplacementCost", "label": "Replacement Cost", "from": "replacement_cost", "type": "number"}
      ]
    },
    {
      "id": "budget-rates",
      "title": "Asset Maintenance Forecast Budget Rates",
      "description": "Synthetic budget rates (AIBAST Asset Maintenance Forecast workshop; fictional).",
      "record_set": "BUDGET_RATES",
      "columns": [
        {"name": "Title", "label": "Budget Rate", "from": "$key", "type": "text"},
        {"name": "BudgetRateId", "label": "Budget Rate ID", "from": "$key", "type": "text"},
        {"name": "WindTurbine", "label": "Wind Turbine", "from": "wind_turbine", "type": "number"},
        {"name": "Transformer", "label": "Transformer", "from": "transformer", "type": "number"},
        {"name": "Pipeline", "label": "Pipeline", "from": "pipeline", "type": "number"},
        {"name": "GasTurbine", "label": "Gas Turbine", "from": "gas_turbine", "type": "number"}
      ]
    }
  ]
}
