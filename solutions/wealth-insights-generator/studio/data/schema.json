{
  "schema": "aibast-studio-data/1.0",
  "solution": "wealth-insights-generator",
  "description": "The workshop's synthetic records as SharePoint lists: the same records the portable agent and the knowledge file hold, one list per record set. Every value is fictional.",
  "source": "agents/@aibast-agents-library/financial_services_stacks/wealth_insights_generator_stack/wealth_insights_generator_agent.py",
  "records_markdown": "solutions/wealth-insights-generator/manual/knowledge/aibast_wealth-insights-generator-synthetic-records.md",
  "lists": [
    {
      "id": "market-data",
      "title": "Wealth Insights Generator Market Data",
      "description": "Synthetic market data (AIBAST Wealth Insights Generator workshop; fictional).",
      "record_set": "MARKET_DATA",
      "columns": [
        {"name": "Title", "label": "Market Data", "from": "$key", "type": "text"},
        {"name": "MarketDataId", "label": "Market Data ID", "from": "$key", "type": "text"},
        {"name": "Current", "label": "Current", "from": "current", "type": "number"},
        {"name": "YtdReturn", "label": "Ytd Return", "from": "ytd_return", "type": "number"},
        {"name": "PeRatio", "label": "Pe Ratio", "from": "pe_ratio", "type": "number"},
        {"name": "DividendYield", "label": "Dividend Yield", "from": "dividend_yield", "type": "number"}
      ]
    },
    {
      "id": "client-portfolios",
      "title": "Wealth Insights Generator Client Portfolios",
      "description": "Synthetic client portfolios (AIBAST Wealth Insights Generator workshop; fictional).",
      "record_set": "CLIENT_PORTFOLIOS",
      "columns": [
        {"name": "Title", "label": "Client Portfolio", "from": "name", "type": "text"},
        {"name": "ClientPortfolioId", "label": "Client Portfolio ID", "from": "$key", "type": "text"},
        {"name": "Aum", "label": "Aum", "from": "aum", "type": "number"},
        {"name": "Strategy", "label": "Strategy", "from": "strategy", "type": "text"},
        {"name": "YtdReturn", "label": "Ytd Return", "from": "ytd_return", "type": "number"},
        {"name": "BenchmarkReturn", "label": "Benchmark Return", "from": "benchmark_return", "type": "number"},
        {"name": "Alpha", "label": "Alpha", "from": "alpha", "type": "number"},
        {"name": "RiskProfile", "label": "Risk Profile", "from": "risk_profile", "type": "text"},
        {"name": "LastContact", "label": "Last Contact", "from": "last_contact", "type": "text"},
        {"name": "NextReview", "label": "Next Review", "from": "next_review", "type": "text"},
        {"name": "LifeEvents", "label": "Life Events", "from": "life_events", "type": "text", "encoding": "joined"},
        {"name": "HeldAwayAssets", "label": "Held Away Assets", "from": "held_away_assets", "type": "number"}
      ]
    },
    {
      "id": "performance-benchmarks",
      "title": "Wealth Insights Generator Performance Benchmarks",
      "description": "Synthetic performance benchmarks (AIBAST Wealth Insights Generator workshop; fictional).",
      "record_set": "PERFORMANCE_BENCHMARKS",
      "columns": [
        {"name": "Title", "label": "Performance Benchmark", "from": "$key", "type": "text"},
        {"name": "PerformanceBenchmarkId", "label": "Performance Benchmark ID", "from": "$key", "type": "text"},
        {"name": "Benchmark", "label": "Benchmark", "from": "benchmark", "type": "text"},
        {"name": "Value1Yr", "label": "1 Yr", "from": "1yr", "type": "number"},
        {"name": "Value3Yr", "label": "3 Yr", "from": "3yr", "type": "number"},
        {"name": "Value5Yr", "label": "5 Yr", "from": "5yr", "type": "number"}
      ]
    },
    {
      "id": "opportunity-signals",
      "title": "Wealth Insights Generator Opportunity Signals",
      "description": "Synthetic opportunity signals (AIBAST Wealth Insights Generator workshop; fictional).",
      "record_set": "OPPORTUNITY_SIGNALS",
      "columns": [
        {"name": "Title", "label": "Opportunity Signal", "from": "client", "type": "text"},
        {"name": "OpportunitySignalId", "label": "Opportunity Signal ID", "from": "$key", "type": "text"},
        {"name": "Type", "label": "Type", "from": "type", "type": "text"},
        {"name": "Description", "label": "Description", "from": "description", "type": "text"},
        {"name": "Priority", "label": "Priority", "from": "priority", "type": "text"},
        {"name": "Action", "label": "Action", "from": "action", "type": "text"}
      ]
    }
  ]
}
