{
  "schema": "aibast-studio-data/1.0",
  "solution": "permit-license-management",
  "description": "The workshop's synthetic records as SharePoint lists: the same records the portable agent and the knowledge file hold, one list per record set. Every value is fictional.",
  "source": "agents/@aibast-agents-library/energy_stacks/permit_license_management_stack/permit_license_management_agent.py",
  "records_markdown": "solutions/permit-license-management/manual/knowledge/permit-license-management-synthetic-records.md",
  "lists": [
    {
      "id": "permits",
      "title": "Permit Management Permits",
      "description": "Synthetic permits (AIBAST Permit Management workshop; fictional).",
      "record_set": "PERMITS",
      "columns": [
        {"name": "Title", "label": "Permit", "from": "name", "type": "text"},
        {"name": "PermitId", "label": "Permit ID", "from": "$key", "type": "text"},
        {"name": "Facility", "label": "Facility", "from": "facility", "type": "text"},
        {"name": "IssuingAuthority", "label": "Issuing Authority", "from": "issuing_authority", "type": "text"},
        {"name": "PermitNumber", "label": "Permit Number", "from": "permit_number", "type": "text"},
        {"name": "IssuedDate", "label": "Issued Date", "from": "issued_date", "type": "text"},
        {"name": "ExpirationDate", "label": "Expiration Date", "from": "expiration_date", "type": "text"},
        {"name": "Status", "label": "Status", "from": "status", "type": "text"},
        {"name": "Type", "label": "Type", "from": "type", "type": "text"},
        {"name": "RenewalLeadDays", "label": "Renewal Lead Days", "from": "renewal_lead_days", "type": "number"},
        {"name": "Conditions", "label": "Conditions", "from": "conditions", "type": "number"},
        {"name": "LastInspection", "label": "Last Inspection", "from": "last_inspection", "type": "text"}
      ]
    },
    {
      "id": "applications",
      "title": "Permit Management Applications",
      "description": "Synthetic applications (AIBAST Permit Management workshop; fictional).",
      "record_set": "APPLICATIONS",
      "columns": [
        {"name": "Title", "label": "Application", "from": "permit_name", "type": "text"},
        {"name": "ApplicationId", "label": "Application ID", "from": "$key", "type": "text"},
        {"name": "Facility", "label": "Facility", "from": "facility", "type": "text"},
        {"name": "SubmittedDate", "label": "Submitted Date", "from": "submitted_date", "type": "text"},
        {"name": "Authority", "label": "Authority", "from": "authority", "type": "text"},
        {"name": "Status", "label": "Status", "from": "status", "type": "text"},
        {"name": "ExpectedDecision", "label": "Expected Decision", "from": "expected_decision", "type": "text"},
        {"name": "CommentsReceived", "label": "Comments Received", "from": "comments_received", "type": "number"}
      ]
    },
    {
      "id": "regulatory-requirements",
      "title": "Permit Management Regulatory Requirements",
      "description": "Synthetic regulatory requirements (AIBAST Permit Management workshop; fictional).",
      "record_set": "REGULATORY_REQUIREMENTS",
      "columns": [
        {"name": "Title", "label": "Regulatory Requirement", "from": "$key", "type": "text"},
        {"name": "RegulatoryRequirementId", "label": "Regulatory Requirement ID", "from": "$key", "type": "text"},
        {"name": "Value", "label": "Value", "from": "$value", "type": "text", "encoding": "joined"}
      ]
    }
  ]
}
