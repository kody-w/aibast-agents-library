{
  "schema": "aibast-studio-data/1.0",
  "solution": "license-renewal-expansion",
  "description": "The workshop's synthetic records as SharePoint lists: the same records the portable agent and the knowledge file hold, one list per record set. Every value is fictional.",
  "source": "agents/@aibast-agents-library/software_dp_stacks/license_renewal_expansion_stack/license_renewal_expansion_agent.py",
  "records_markdown": "solutions/license-renewal-expansion/manual/knowledge/aibast_license-renewal-expansion-synthetic-records.md",
  "lists": [
    {
      "id": "license-agreements",
      "title": "License Renewal and Expansion License Agreements",
      "description": "Synthetic license agreements (AIBAST License Renewal and Expansion workshop; fictional).",
      "record_set": "LICENSE_AGREEMENTS",
      "columns": [
        {"name": "Title", "label": "License Agreement", "from": "customer", "type": "text"},
        {"name": "LicenseAgreementId", "label": "License Agreement ID", "from": "$key", "type": "text"},
        {"name": "Plan", "label": "Plan", "from": "plan", "type": "text"},
        {"name": "Arr", "label": "Arr", "from": "arr", "type": "number"},
        {"name": "Seats", "label": "Seats", "from": "seats", "type": "number"},
        {"name": "SeatsUsed", "label": "Seats Used", "from": "seats_used", "type": "number"},
        {"name": "RenewalDate", "label": "Renewal Date", "from": "renewal_date", "type": "text"},
        {"name": "ContractStart", "label": "Contract Start", "from": "contract_start", "type": "text"},
        {"name": "UsageTrend", "label": "Usage Trend", "from": "usage_trend", "type": "text"},
        {"name": "NPSScore", "label": "NPS Score", "from": "nps_score", "type": "number"},
        {"name": "SupportTickets90D", "label": "Support Tickets 90 D", "from": "support_tickets_90d", "type": "number"},
        {"name": "ExpansionSignals", "label": "Expansion Signals", "from": "expansion_signals", "type": "text", "encoding": "joined"},
        {"name": "ChurnSignals", "label": "Churn Signals", "from": "churn_signals", "type": "text", "encoding": "joined"},
        {"name": "Csm", "label": "Csm", "from": "csm", "type": "text"},
        {"name": "HealthScore", "label": "Health Score", "from": "health_score", "type": "number"}
      ]
    },
    {
      "id": "expansion-pricing",
      "title": "License Renewal and Expansion Expansion Pricing",
      "description": "Synthetic expansion pricing (AIBAST License Renewal and Expansion workshop; fictional).",
      "record_set": "EXPANSION_PRICING",
      "columns": [
        {"name": "Title", "label": "Expansion Pricing", "from": "$key", "type": "text"},
        {"name": "ExpansionPricingId", "label": "Expansion Pricing ID", "from": "$key", "type": "text"},
        {"name": "UnitPrice", "label": "Unit Price", "from": "unit_price", "type": "number", "optional": true},
        {"name": "MinQty", "label": "Min Qty", "from": "min_qty", "type": "number", "optional": true},
        {"name": "Price", "label": "Price", "from": "price", "type": "number", "optional": true},
        {"name": "Description", "label": "Description", "from": "description", "type": "text", "optional": true}
      ]
    },
    {
      "id": "switching-cost-assumptions",
      "title": "License Renewal and Expansion Switching Cost Assumptions",
      "description": "Synthetic switching cost assumptions (AIBAST License Renewal and Expansion workshop; fictional).",
      "record_set": "SWITCHING_COST_ASSUMPTIONS",
      "columns": [
        {"name": "Title", "label": "Switching Cost Assumption", "from": "$key", "type": "text"},
        {"name": "SwitchingCostAssumptionId", "label": "Switching Cost Assumption ID", "from": "$key", "type": "text"},
        {"name": "Value", "label": "Value", "from": "$value", "type": "number"}
      ]
    }
  ]
}
