        {"name": "Title", "label": "Impl Phase", "from": "name", "type": "text"},
        {"name": "ImplPhaseId", "label": "Impl Phase ID", "from": "$key", "type": "text"},
        {"name": "Phase", "label": "Phase", "from": "phase", "type": "number"},
        {"name": "DurationWeeks", "label": "Duration Weeks", "from": "duration_weeks", "type": "number"},
        {"name": "Activities", "label": "Activities", "from": "activities", "type": "text", "encoding": "joined"}
