        {"name": "Size", "label": "Size", "from": "size", "type": "text"},
        {"name": "Results", "label": "Results", "from": "results", "type": "text"},
        {"name": "ImplWeeks", "label": "Impl Weeks", "from": "impl_weeks", "type": "number"},
        {"name": "ContactReady", "label": "Contact Ready", "from": "contact_ready", "type": "text"}
      ]
    },
    {
