{
  "schema": "aibast-studio-data/1.0",
  "solution": "proposal-generation",
  "description": "The workshop's synthetic records as SharePoint lists: the same records the portable agent and the knowledge file hold, one list per record set. Every value is fictional.",
  "source": "agents/@aibast-agents-library/b2b_sales_stacks/proposal_generation_stack/proposal_generation_agent.py",
  "records_markdown": "solutions/proposal-generation/manual/knowledge/aibast_proposal-generation-synthetic-records.md",
  "lists": [
    {
      "id": "rfps",
      "title": "Proposal Generation RFPS",
      "description": "Synthetic rfps (AIBAST Proposal Generation workshop; fictional).",
      "record_set": "_RFPS",
      "columns": [
        {"name": "Title", "label": "RFP", "from": "project", "type": "text"},
        {"name": "RFPId", "label": "RFP ID", "from": "$key", "type": "text"},
        {"name": "ID", "label": "ID", "from": "id", "type": "text"},
        {"name": "Account", "label": "Account", "from": "account", "type": "text"},
        {"name": "Industry", "label": "Industry", "from": "industry", "type": "text"},
        {"name": "DealValue", "label": "Deal Value", "from": "deal_value", "type": "number"},
        {"name": "BudgetCeiling", "label": "Budget Ceiling", "from": "budget_ceiling", "type": "number"},
        {"name": "DecisionTimelineDays", "label": "Decision Timeline Days", "from": "decision_timeline_days", "type": "number"},
        {"name": "KeyStakeholder", "label": "Key Stakeholder", "from": "key_stakeholder", "type": "text"},
        {"name": "CompetitorsShortlisted", "label": "Competitors Shortlisted", "from": "competitors_shortlisted", "type": "text", "encoding": "joined"},
        {"name": "Requirements", "label": "Requirements", "from": "requirements", "type": "text", "encoding": "json"},
        {"name": "ExistingAssets", "label": "Existing Assets", "from": "existing_assets", "type": "text", "encoding": "joined"}
      ]
    },
    {
      "id": "product-catalog",
      "title": "Proposal Generation Product Catalog",
      "description": "Synthetic product catalog (AIBAST Proposal Generation workshop; fictional).",
      "record_set": "_PRODUCT_CATALOG",
      "columns": [
        {"name": "Title", "label": "Product Catalog", "from": "name", "type": "text"},
        {"name": "ProductCatalogId", "label": "Product Catalog ID", "from": "$key", "type": "text"},
        {"name": "ListPrice", "label": "List Price", "from": "list_price", "type": "number"},
        {"name": "Category", "label": "Category", "from": "category", "type": "text"},
        {"name": "MarginFloor", "label": "Margin Floor", "from": "margin_floor", "type": "number"}
