      "record_set": "_DISCOUNT_RULES",
      "columns": [
        {"name": "Title", "label": "Discount Rule", "from": "$key", "type": "text"},
        {"name": "DiscountRuleId", "label": "Discount Rule ID", "from": "$key", "type": "text"},
        {"name": "Base", "label": "Base", "from": "base", "type": "number"},
        {"name": "VolumeThreshold", "label": "Volume Threshold", "from": "volume_threshold", "type": "number"},
        {"name": "VolumeBonus", "label": "Volume Bonus", "from": "volume_bonus", "type": "number"},
        {"name": "Max", "label": "Max", "from": "max", "type": "number"}
