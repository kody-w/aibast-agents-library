        {"name": "Title", "label": "Solution Config", "from": "$key", "type": "text"},
        {"name": "SolutionConfigId", "label": "Solution Config ID", "from": "$key", "type": "text"},
        {"name": "Value", "label": "Value", "from": "$value", "type": "text", "encoding": "joined"}
