        {"name": "SupportSLAMin", "label": "Support SLA Min", "from": "support_sla_min", "type": "number"},
        {"name": "PricingPosition", "label": "Pricing Position", "from": "pricing_position", "type": "text"},
        {"name": "Strengths", "label": "Strengths", "from": "strengths", "type": "text", "encoding": "joined"},
        {"name": "Weaknesses", "label": "Weaknesses", "from": "weaknesses", "type": "text", "encoding": "joined"}
      ]
    },
    {
      "id": "our-capabilities",
      "title": "Proposal Generation Our Capabilities",
      "description": "Synthetic our capabilities (AIBAST Proposal Generation workshop; fictional).",
      "record_set": "_OUR_CAPABILITIES",
      "columns": [
        {"name": "Title", "label": "Our Capability", "from": "$key", "type": "text"},
        {"name": "OurCapabilityId", "label": "Our Capability ID", "from": "$key", "type": "text"},
        {"name": "Value", "label": "Value", "from": "$value", "type": "text", "encoding": "joined"}
