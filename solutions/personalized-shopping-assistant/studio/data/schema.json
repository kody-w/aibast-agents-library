{
  "schema": "aibast-studio-data/1.0",
  "solution": "personalized-shopping-assistant",
  "description": "The workshop's synthetic records as SharePoint lists: the same records the portable agent and the knowledge file hold, one list per record set. Every value is fictional.",
  "source": "agents/@aibast-agents-library/b2c_sales_stacks/personalized_shopping_assistant_stack/personalized_shopping_assistant_agent.py",
  "records_markdown": "solutions/personalized-shopping-assistant/manual/knowledge/aibast_shopping-assistant-synthetic-records.md",
  "lists": [
    {
      "id": "product-catalog",
      "title": "Personalized Shopping Product Catalog",
      "description": "Synthetic product catalog (AIBAST Personalized Shopping workshop; fictional).",
      "record_set": "PRODUCT_CATALOG",
      "columns": [
        {"name": "Title", "label": "Product Catalog", "from": "name", "type": "text"},
        {"name": "ProductCatalogId", "label": "Product Catalog ID", "from": "$key", "type": "text"},
        {"name": "Category", "label": "Category", "from": "category", "type": "text"},
        {"name": "Subcategory", "label": "Subcategory", "from": "subcategory", "type": "text"},
        {"name": "Price", "label": "Price", "from": "price", "type": "number"},
        {"name": "Brand", "label": "Brand", "from": "brand", "type": "text"},
        {"name": "Sizes", "label": "Sizes", "from": "sizes", "type": "text", "encoding": "joined"},
        {"name": "Colors", "label": "Colors", "from": "colors", "type": "text", "encoding": "joined"},
        {"name": "StyleTags", "label": "Style Tags", "from": "style_tags", "type": "text", "encoding": "joined"},
        {"name": "Rating", "label": "Rating", "from": "rating", "type": "number"},
        {"name": "StockS", "label": "Stock S", "from": "stock.S", "type": "number", "optional": true},
        {"name": "StockM", "label": "Stock M", "from": "stock.M", "type": "number", "optional": true},
        {"name": "StockL", "label": "Stock L", "from": "stock.L", "type": "number", "optional": true},
        {"name": "StockXl", "label": "Stock Xl", "from": "stock.XL", "type": "number", "optional": true},
        {"name": "Stock30", "label": "Stock 30", "from": "stock.30", "type": "number", "optional": true},
        {"name": "Stock32", "label": "Stock 32", "from": "stock.32", "type": "number", "optional": true},
        {"name": "Stock34", "label": "Stock 34", "from": "stock.34", "type": "number", "optional": true},
        {"name": "Stock36", "label": "Stock 36", "from": "stock.36", "type": "number", "optional": true},
        {"name": "Stock8", "label": "Stock 8", "from": "stock.8", "type": "number", "optional": true},
        {"name": "Stock9", "label": "Stock 9", "from": "stock.9", "type": "number", "optional": true},
        {"name": "Stock10", "label": "Stock 10", "from": "stock.10", "type": "number", "optional": true},
        {"name": "Stock11", "label": "Stock 11", "from": "stock.11", "type": "number", "optional": true},
        {"name": "Stock12", "label": "Stock 12", "from": "stock.12", "type": "number", "optional": true},
        {"name": "StockOs", "label": "Stock Os", "from": "stock.OS", "type": "number", "optional": true}
      ]
    },
    {
      "id": "customer-preferences",
      "title": "Personalized Shopping Customer Preferences",
      "description": "Synthetic customer preferences (AIBAST Personalized Shopping workshop; fictional).",
      "record_set": "CUSTOMER_PREFERENCES",
      "columns": [
        {"name": "Title", "label": "Customer Preference", "from": "name", "type": "text"},
        {"name": "CustomerPreferenceId", "label": "Customer Preference ID", "from": "$key", "type": "text"},
        {"name": "SizeTop", "label": "Size Top", "from": "size_top", "type": "text"},
        {"name": "SizeBottom", "label": "Size Bottom", "from": "size_bottom", "type": "text"},
        {"name": "SizeShoe", "label": "Size Shoe", "from": "size_shoe", "type": "text"},
        {"name": "StylePreference", "label": "Style Preference", "from": "style_preference", "type": "text", "encoding": "joined"},
        {"name": "BrandAffinity", "label": "Brand Affinity", "from": "brand_affinity", "type": "text", "encoding": "joined"},
        {"name": "ColorPreference", "label": "Color Preference", "from": "color_preference", "type": "text", "encoding": "joined"},
        {"name": "BudgetRangeMin", "label": "Budget Range Min", "from": "budget_range.min", "type": "number"},
        {"name": "BudgetRangeMax", "label": "Budget Range Max", "from": "budget_range.max", "type": "number"},
        {"name": "PurchaseHistory", "label": "Purchase History", "from": "purchase_history", "type": "text", "encoding": "joined"}
      ]
    },
    {
      "id": "outfit-templates",
      "title": "Personalized Shopping Outfit Templates",
      "description": "Synthetic outfit templates (AIBAST Personalized Shopping workshop; fictional).",
      "record_set": "OUTFIT_TEMPLATES",
      "columns": [
        {"name": "Title", "label": "Outfit Template", "from": "name", "type": "text"},
        {"name": "OutfitTemplateId", "label": "Outfit Template ID", "from": "$key", "type": "text"},
        {"name": "Pieces", "label": "Pieces", "from": "pieces", "type": "text", "encoding": "joined"}
      ]
    }
  ]
}
