{
  "schema": "aibast-studio-data/1.0",
  "solution": "customer-sentiment-churn",
  "description": "The workshop's synthetic records as SharePoint lists: the same records the portable agent and the knowledge file hold, one list per record set. Every value is fictional.",
  "source": "agents/@aibast-agents-library/financial_services_stacks/customer_sentiment_churn_stack/customer_sentiment_churn_agent.py",
  "records_markdown": "solutions/customer-sentiment-churn/manual/knowledge/aibast_customer-sentiment-churn-synthetic-records.md",
  "lists": [
    {
      "id": "customer-interactions",
      "title": "Cust Sentiment Churn Pred Customer Interactions",
      "description": "Synthetic customer interactions (AIBAST Customer Sentiment and Churn Prediction workshop; fictional).",
      "record_set": "CUSTOMER_INTERACTIONS",
      "columns": [
        {"name": "Title", "label": "Customer Interaction", "from": "name", "type": "text"},
        {"name": "CustomerInteractionId", "label": "Customer Interaction ID", "from": "$key", "type": "text"},
        {"name": "Segment", "label": "Segment", "from": "segment", "type": "text"},
        {"name": "TenureYears", "label": "Tenure Years", "from": "tenure_years", "type": "number"},
        {"name": "Products", "label": "Products", "from": "products", "type": "text", "encoding": "joined"},
        {"name": "NPSScore", "label": "NPS Score", "from": "nps_score", "type": "number"},
        {"name": "LastSurvey", "label": "Last Survey", "from": "last_survey", "type": "text"},
        {"name": "RecentInteractions", "label": "Recent Interactions", "from": "recent_interactions", "type": "text", "encoding": "json"},
        {"name": "MonthlyTransactions", "label": "Monthly Transactions", "from": "monthly_transactions", "type": "number"},
        {"name": "DigitalEngagementScore", "label": "Digital Engagement Score", "from": "digital_engagement_score", "type": "number"},
        {"name": "ComplaintCount12M", "label": "Complaint Count 12 M", "from": "complaint_count_12m", "type": "number"}
      ]
    },
    {
      "id": "churn-indicators",
      "title": "Customer Sentiment and Churn Prediction Churn Indicators",
      "description": "Synthetic churn indicators (AIBAST Customer Sentiment and Churn Prediction workshop; fictional).",
      "record_set": "CHURN_INDICATORS",
      "columns": [
        {"name": "Title", "label": "Churn Indicator", "from": "description", "type": "text"},
        {"name": "ChurnIndicatorId", "label": "Churn Indicator ID", "from": "$key", "type": "text"},
        {"name": "Threshold", "label": "Threshold", "from": "threshold", "type": "number"},
        {"name": "Weight", "label": "Weight", "from": "weight", "type": "number"}
      ]
    },
    {
      "id": "retention-actions",
      "title": "Customer Sentiment and Churn Prediction Retention Actions",
      "description": "Synthetic retention actions (AIBAST Customer Sentiment and Churn Prediction workshop; fictional).",
      "record_set": "RETENTION_ACTIONS",
      "columns": [
        {"name": "Title", "label": "Retention Action", "from": "description", "type": "text"},
        {"name": "RetentionActionId", "label": "Retention Action ID", "from": "$key", "type": "text"},
        {"name": "Cost", "label": "Cost", "from": "cost", "type": "number"},
        {"name": "SuccessRate", "label": "Success Rate", "from": "success_rate", "type": "number"}
      ]
    },
    {
      "id": "segment-benchmarks",
      "title": "Customer Sentiment and Churn Prediction Segment Benchmarks",
      "description": "Synthetic segment benchmarks (AIBAST Customer Sentiment and Churn Prediction workshop; fictional).",
      "record_set": "SEGMENT_BENCHMARKS",
      "columns": [
        {"name": "Title", "label": "Segment Benchmark", "from": "$key", "type": "text"},
        {"name": "SegmentBenchmarkId", "label": "Segment Benchmark ID", "from": "$key", "type": "text"},
        {"name": "AvgNPS", "label": "Avg NPS", "from": "avg_nps", "type": "number"},
        {"name": "AvgProducts", "label": "Avg Products", "from": "avg_products", "type": "number"},
        {"name": "AvgTenure", "label": "Avg Tenure", "from": "avg_tenure", "type": "number"},
        {"name": "AvgTransactions", "label": "Avg Transactions", "from": "avg_transactions", "type": "number"}
      ]
    }
  ]
}
