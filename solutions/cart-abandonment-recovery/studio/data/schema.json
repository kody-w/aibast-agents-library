{
  "schema": "aibast-studio-data/1.0",
  "solution": "cart-abandonment-recovery",
  "description": "The workshop's synthetic records as SharePoint lists: the same records the portable agent and the knowledge file hold, one list per record set. Every value is fictional.",
  "source": "agents/@aibast-agents-library/b2c_sales_stacks/cart_abandonment_recovery_stack/cart_abandonment_recovery_agent.py",
  "records_markdown": "solutions/cart-abandonment-recovery/manual/knowledge/aibast_cart-recovery-synthetic-records.md",
  "lists": [
    {
      "id": "abandoned-carts",
      "title": "Cart Abandonment Recovery Abandoned Carts",
      "description": "Synthetic abandoned carts (AIBAST Cart Abandonment Recovery workshop; fictional).",
      "record_set": "ABANDONED_CARTS",
      "columns": [
        {"name": "Title", "label": "Abandoned Cart", "from": "shopper_label", "type": "text"},
        {"name": "AbandonedCartId", "label": "Abandoned Cart ID", "from": "$key", "type": "text"},
        {"name": "Contactable", "label": "Contactable", "from": "contactable", "type": "text"},
        {"name": "Segment", "label": "Segment", "from": "segment", "type": "text"},
        {"name": "Items", "label": "Items", "from": "items", "type": "text", "encoding": "json"},
        {"name": "CartValue", "label": "Cart Value", "from": "cart_value", "type": "number"},
        {"name": "AbandonedAt", "label": "Abandoned At", "from": "abandoned_at", "type": "text"},
        {"name": "PageExit", "label": "Page Exit", "from": "page_exit", "type": "text"},
        {"name": "Device", "label": "Device", "from": "device", "type": "text"},
        {"name": "PriorPurchases", "label": "Prior Purchases", "from": "prior_purchases", "type": "number"},
        {"name": "RecoveryStatus", "label": "Recovery Status", "from": "recovery_status", "type": "text"}
      ]
    },
    {
      "id": "recovery-campaigns",
      "title": "Cart Abandonment Recovery Recovery Campaigns",
      "description": "Synthetic recovery campaigns (AIBAST Cart Abandonment Recovery workshop; fictional).",
      "record_set": "RECOVERY_CAMPAIGNS",
      "columns": [
        {"name": "Title", "label": "Recovery Campaign", "from": "name", "type": "text"},
        {"name": "RecoveryCampaignId", "label": "Recovery Campaign ID", "from": "$key", "type": "text"},
        {"name": "DelayHours", "label": "Delay Hours", "from": "delay_hours", "type": "number"},
        {"name": "Subject", "label": "Subject", "from": "subject", "type": "text"},
        {"name": "Incentive", "label": "Incentive", "from": "incentive", "type": "text"},
        {"name": "AvgOpenRate", "label": "Avg Open Rate", "from": "avg_open_rate", "type": "number"},
        {"name": "AvgConversion", "label": "Avg Conversion", "from": "avg_conversion", "type": "number"}
      ]
    },
    {
      "id": "incentive-options",
      "title": "Cart Abandonment Recovery Incentive Options",
      "description": "Synthetic incentive options (AIBAST Cart Abandonment Recovery workshop; fictional).",
      "record_set": "INCENTIVE_OPTIONS",
      "columns": [
        {"name": "Title", "label": "Incentive Option", "from": "description", "type": "text"},
        {"name": "IncentiveOptionId", "label": "Incentive Option ID", "from": "$key", "type": "text"},
        {"name": "CostMarginImpact", "label": "Cost Margin Impact", "from": "cost_margin_impact", "type": "number"},
        {"name": "ConversionLift", "label": "Conversion Lift", "from": "conversion_lift", "type": "number"}
      ]
    },
    {
      "id": "conversion-metrics",
      "title": "Cart Abandonment Recovery Conversion Metrics",
      "description": "Synthetic conversion metrics (AIBAST Cart Abandonment Recovery workshop; fictional).",
      "record_set": "CONVERSION_METRICS",
      "columns": [
        {"name": "Title", "label": "Conversion Metric", "from": "$key", "type": "text"},
        {"name": "ConversionMetricId", "label": "Conversion Metric ID", "from": "$key", "type": "text"},
        {"name": "Value", "label": "Value", "from": "$value", "type": "number"}
      ]
    }
  ]
}
