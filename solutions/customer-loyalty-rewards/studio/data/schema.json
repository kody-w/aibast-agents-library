{
  "schema": "aibast-studio-data/1.0",
  "solution": "customer-loyalty-rewards",
  "description": "The workshop's synthetic records as SharePoint lists: the same records the portable agent and the knowledge file hold, one list per record set. Every value is fictional.",
  "source": "agents/@aibast-agents-library/b2c_sales_stacks/customer_loyalty_rewards_stack/customer_loyalty_rewards_agent.py",
  "records_markdown": "solutions/customer-loyalty-rewards/manual/knowledge/aibast_loyalty-rewards-synthetic-records.md",
  "lists": [
    {
      "id": "loyalty-members",
      "title": "Customer Loyalty and Rewards Loyalty Members",
      "description": "Synthetic loyalty members (AIBAST Customer Loyalty and Rewards workshop; fictional).",
      "record_set": "LOYALTY_MEMBERS",
      "columns": [
        {"name": "Title", "label": "Loyalty Member", "from": "name", "type": "text"},
        {"name": "LoyaltyMemberId", "label": "Loyalty Member ID", "from": "$key", "type": "text"},
        {"name": "Tier", "label": "Tier", "from": "tier", "type": "text"},
        {"name": "PointsBalance", "label": "Points Balance", "from": "points_balance", "type": "number"},
        {"name": "PointsEarnedYtd", "label": "Points Earned Ytd", "from": "points_earned_ytd", "type": "number"},
        {"name": "PointsRedeemedYtd", "label": "Points Redeemed Ytd", "from": "points_redeemed_ytd", "type": "number"},
        {"name": "MemberSince", "label": "Member Since", "from": "member_since", "type": "text"},
        {"name": "TotalSpendYtd", "label": "Total Spend Ytd", "from": "total_spend_ytd", "type": "number"},
        {"name": "EngagementScore", "label": "Engagement Score", "from": "engagement_score", "type": "number"},
        {"name": "PreferredRewards", "label": "Preferred Rewards", "from": "preferred_rewards", "type": "text", "encoding": "joined"}
      ]
    },
    {
      "id": "tier-structure",
      "title": "Customer Loyalty and Rewards Tier Structure",
      "description": "Synthetic tier structure (AIBAST Customer Loyalty and Rewards workshop; fictional).",
      "record_set": "TIER_STRUCTURE",
      "columns": [
        {"name": "Title", "label": "Tier Structure", "from": "$key", "type": "text"},
        {"name": "TierStructureId", "label": "Tier Structure ID", "from": "$key", "type": "text"},
        {"name": "MinSpend", "label": "Min Spend", "from": "min_spend", "type": "number"},
        {"name": "PointsMultiplier", "label": "Points Multiplier", "from": "points_multiplier", "type": "number"},
        {"name": "Perks", "label": "Perks", "from": "perks", "type": "text", "encoding": "joined"},
        {"name": "NextTier", "label": "Next Tier", "from": "next_tier", "type": "text"},
        {"name": "SpendToNext", "label": "Spend To Next", "from": "spend_to_next", "type": "number"}
      ]
    },
    {
      "id": "redemption-catalog",
      "title": "Customer Loyalty and Rewards Redemption Catalog",
      "description": "Synthetic redemption catalog (AIBAST Customer Loyalty and Rewards workshop; fictional).",
      "record_set": "REDEMPTION_CATALOG",
      "columns": [
        {"name": "Title", "label": "Redemption Catalog", "from": "name", "type": "text"},
        {"name": "RedemptionCatalogId", "label": "Redemption Catalog ID", "from": "$key", "type": "text"},
        {"name": "PointsCost", "label": "Points Cost", "from": "points_cost", "type": "number"},
        {"name": "Category", "label": "Category", "from": "category", "type": "text"},
        {"name": "Value", "label": "Value", "from": "value", "type": "number"}
      ]
    },
    {
      "id": "engagement-activities",
      "title": "Customer Loyalty and Rewards Engagement Activities",
      "description": "Synthetic engagement activities (AIBAST Customer Loyalty and Rewards workshop; fictional).",
      "record_set": "ENGAGEMENT_ACTIVITIES",
      "columns": [
        {"name": "Title", "label": "Engagement Activity", "from": "$key", "type": "text"},
        {"name": "EngagementActivityId", "label": "Engagement Activity ID", "from": "$key", "type": "text"},
        {"name": "Activity", "label": "Activity", "from": "activity", "type": "text"},
        {"name": "Points", "label": "Points", "from": "points", "type": "text"},
        {"name": "Frequency", "label": "Frequency", "from": "frequency", "type": "text"}
      ]
    }
  ]
}
