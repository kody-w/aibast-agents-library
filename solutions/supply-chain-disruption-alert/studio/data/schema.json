      "columns": [
        {"name": "Title", "label": "Supply Route", "from": "name", "type": "text"},
        {"name": "SupplyRouteId", "label": "Supply Route ID", "from": "$key", "type": "text"},
        {"name": "Origin", "label": "Origin", "from": "origin", "type": "text"},
        {"name": "Destination", "label": "Destination", "from": "destination", "type": "text"},
        {"name": "TransportMode", "label": "Transport Mode", "from": "transport_mode", "type": "text"},
        {"name": "TransitDays", "label": "Transit Days", "from": "transit_days", "type": "number"},
        {"name": "Carriers", "label": "Carriers", "from": "carriers", "type": "text", "encoding": "joined"},
        {"name": "AnnualVolumeTeu", "label": "Annual Volume Teu", "from": "annual_volume_teu", "type": "number"},
        {"name": "AnnualValueUSD", "label": "Annual Value USD", "from": "annual_value_usd", "type": "number"},
        {"name": "Categories", "label": "Categories", "from": "categories", "type": "text", "encoding": "joined"},
        {"name": "CurrentStatus", "label": "Current Status", "from": "current_status", "type": "text"},
        {"name": "ReliabilityScore", "label": "Reliability Score", "from": "reliability_score", "type": "number"}
