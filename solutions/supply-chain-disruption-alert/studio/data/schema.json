        {"name": "Title", "label": "Alternative Supplier", "from": "$key", "type": "text"},
        {"name": "AlternativeSupplierId", "label": "Alternative Supplier ID", "from": "$key", "type": "text"},
        {"name": "Value", "label": "Value", "from": "$value", "type": "text", "encoding": "json"}
