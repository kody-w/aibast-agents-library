        {"name": "Status", "label": "Status", "from": "status", "type": "text"}
      ]
    },
    {
      "id": "risk-scores",
      "title": "Supply Chain Disruption Alert Risk Scores",
      "description": "Synthetic risk scores (AIBAST Supply Chain Disruption Alert workshop; fictional).",
      "record_set": "RISK_SCORES",
      "columns": [
        {"name": "Title", "label": "Risk Score", "from": "$key", "type": "text"},
