{
  "schema": "aibast-studio-data/1.0",
  "solution": "omnichannel-engagement",
  "description": "The workshop's synthetic records as SharePoint lists: the same records the portable agent and the knowledge file hold, one list per record set. Every value is fictional.",
  "source": "agents/@aibast-agents-library/b2c_sales_stacks/omnichannel_engagement_stack/omnichannel_engagement_agent.py",
  "records_markdown": "solutions/omnichannel-engagement/manual/knowledge/aibast_omnichannel-synthetic-records.md",
  "lists": [
    {
      "id": "channels",
      "title": "Omnichannel Engagement Channels",
      "description": "Synthetic channels (AIBAST Omnichannel Engagement workshop; fictional).",
      "record_set": "CHANNELS",
      "columns": [
        {"name": "Title", "label": "Channel", "from": "$key", "type": "text"},
        {"name": "ChannelId", "label": "Channel ID", "from": "$key", "type": "text"},
        {"name": "Sessions30D", "label": "Sessions 30 D", "from": "sessions_30d", "type": "number"},
        {"name": "Conversions30D", "label": "Conversions 30 D", "from": "conversions_30d", "type": "number"},
        {"name": "Revenue30D", "label": "Revenue 30 D", "from": "revenue_30d", "type": "number"},
        {"name": "Cost30D", "label": "Cost 30 D", "from": "cost_30d", "type": "number"},
        {"name": "AvgOrderValue", "label": "Avg Order Value", "from": "avg_order_value", "type": "number"},
        {"name": "BounceRate", "label": "Bounce Rate", "from": "bounce_rate", "type": "number"}
      ]
    },
    {
      "id": "customer-journeys",
      "title": "Omnichannel Engagement Customer Journeys",
      "description": "Synthetic customer journeys (AIBAST Omnichannel Engagement workshop; fictional).",
      "record_set": "CUSTOMER_JOURNEYS",
      "columns": [
        {"name": "Title", "label": "Customer Journey", "from": "name", "type": "text"},
        {"name": "CustomerJourneyId", "label": "Customer Journey ID", "from": "$key", "type": "text"},
        {"name": "Touchpoints", "label": "Touchpoints", "from": "touchpoints", "type": "text", "encoding": "joined"},
        {"name": "AvgDays", "label": "Avg Days", "from": "avg_days", "type": "number"},
        {"name": "ConversionRate", "label": "Conversion Rate", "from": "conversion_rate", "type": "number"},
        {"name": "AvgTouchpoints", "label": "Avg Touchpoints", "from": "avg_touchpoints", "type": "number"}
      ]
    },
    {
      "id": "campaign-results",
      "title": "Omnichannel Engagement Campaign Results",
      "description": "Synthetic campaign results (AIBAST Omnichannel Engagement workshop; fictional).",
      "record_set": "CAMPAIGN_RESULTS",
      "columns": [
        {"name": "Title", "label": "Campaign Result", "from": "name", "type": "text"},
        {"name": "CampaignResultId", "label": "Campaign Result ID", "from": "$key", "type": "text"},
        {"name": "Channel", "label": "Channel", "from": "channel", "type": "text"},
        {"name": "Sent", "label": "Sent", "from": "sent", "type": "number"},
        {"name": "Opens", "label": "Opens", "from": "opens", "type": "number"},
        {"name": "Clicks", "label": "Clicks", "from": "clicks", "type": "number"},
        {"name": "Conversions", "label": "Conversions", "from": "conversions", "type": "number"},
        {"name": "Revenue", "label": "Revenue", "from": "revenue", "type": "number"},
        {"name": "Cost", "label": "Cost", "from": "cost", "type": "number"}
      ]
    }
  ]
}
