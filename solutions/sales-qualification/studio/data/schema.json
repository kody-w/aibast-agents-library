{
  "schema": "aibast-studio-data/1.0",
  "solution": "sales-qualification",
  "description": "The workshop's synthetic records as SharePoint lists: the same records the portable agent and the knowledge file hold, one list per record set. Every value is fictional.",
  "source": "agents/@aibast-agents-library/b2b_sales_stacks/sales_qualification_stack/sales_qualification_agent.py",
  "records_markdown": "solutions/sales-qualification/manual/knowledge/aibast_sales-qualification-synthetic-records.md",
  "lists": [
    {
      "id": "icp",
      "title": "Sales Qualification ICP",
      "description": "Synthetic icp (AIBAST Sales Qualification workshop; fictional).",
      "record_set": "_ICP",
      "columns": [
        {"name": "Title", "label": "ICP", "from": "$key", "type": "text"},
        {"name": "ICPId", "label": "ICP ID", "from": "$key", "type": "text"},
        {"name": "Value", "label": "Value", "from": "$value", "type": "text", "encoding": "json"}
      ]
    },
    {
      "id": "ae-team",
      "title": "Sales Qualification AE Team",
      "description": "Synthetic ae team (AIBAST Sales Qualification workshop; fictional).",
      "record_set": "_AE_TEAM",
      "columns": [
        {"name": "Title", "label": "AE Team", "from": "name", "type": "text"},
        {"name": "AETeamId", "label": "AE Team ID", "from": "$key", "type": "text"},
        {"name": "Territory", "label": "Territory", "from": "territory", "type": "text"},
        {"name": "Specialty", "label": "Specialty", "from": "specialty", "type": "text"},
        {"name": "CurrentCapacityPct", "label": "Current Capacity Pct", "from": "current_capacity_pct", "type": "number"},
        {"name": "MaxLeads", "label": "Max Leads", "from": "max_leads", "type": "number"}
      ]
    },
    {
      "id": "sla-rules",
      "title": "Sales Qualification SLA Rules",
      "description": "Synthetic sla rules (AIBAST Sales Qualification workshop; fictional).",
      "record_set": "_SLA_RULES",
      "columns": [
        {"name": "Title", "label": "SLA Rule", "from": "$key", "type": "text"},
        {"name": "SLARuleId", "label": "SLA Rule ID", "from": "$key", "type": "text"},
        {"name": "ResponseHours", "label": "Response Hours", "from": "response_hours", "type": "number"},
        {"name": "Escalation", "label": "Escalation", "from": "escalation", "type": "text"},
        {"name": "Sequence", "label": "Sequence", "from": "sequence", "type": "text"}
      ]
    },
    {
      "id": "leads",
      "title": "Sales Qualification Leads",
      "description": "Synthetic leads (AIBAST Sales Qualification workshop; fictional).",
      "record_set": "_LEADS",
      "columns": [
        {"name": "Title", "label": "Lead", "from": "contact_name", "type": "text"},
        {"name": "LeadId", "label": "Lead ID", "from": "id", "type": "text"},
        {"name": "Company", "label": "Company", "from": "company", "type": "text"},
        {"name": "Titleaaf2320", "label": "Title", "from": "title", "type": "text"},
        {"name": "Employees", "label": "Employees", "from": "employees", "type": "number"},
        {"name": "Industry", "label": "Industry", "from": "industry", "type": "text"},
        {"name": "Revenue", "label": "Revenue", "from": "revenue", "type": "number"},
        {"name": "Source", "label": "Source", "from": "source", "type": "text"},
        {"name": "Budget", "label": "Budget", "from": "budget", "type": "text"},
        {"name": "AuthorityLevel", "label": "Authority Level", "from": "authority_level", "type": "text"},
        {"name": "Need", "label": "Need", "from": "need", "type": "text"},
        {"name": "Timeline", "label": "Timeline", "from": "timeline", "type": "text"},
        {"name": "EngagementSignals", "label": "Engagement Signals", "from": "engagement_signals", "type": "text", "encoding": "joined"},
        {"name": "TechStack", "label": "Tech Stack", "from": "tech_stack", "type": "text", "encoding": "joined"}
      ]
    }
  ]
}
