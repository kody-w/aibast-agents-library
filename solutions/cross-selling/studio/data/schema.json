{
  "schema": "aibast-studio-data/1.0",
  "solution": "cross-selling",
  "description": "The workshop's synthetic records as SharePoint lists: the same records the portable agent and the knowledge file hold, one list per record set. Every value is fictional.",
  "source": "agents/@aibast-agents-library/general_stacks/cross_selling_opportunities_stack/cross_selling_agent.py",
  "records_markdown": "solutions/cross-selling/manual/knowledge/aibast_cross-selling-synthetic-records.md",
  "lists": [
    {
      "id": "product-catalog",
      "title": "Cross Selling Opportunities Product Catalog",
      "description": "Synthetic product catalog (AIBAST Cross-Selling Opportunities workshop; fictional).",
      "record_set": "_PRODUCT_CATALOG",
      "columns": [
        {"name": "Title", "label": "Product Catalog", "from": "name", "type": "text"},
        {"name": "ProductCatalogId", "label": "Product Catalog ID", "from": "$key", "type": "text"},
        {"name": "Category", "label": "Category", "from": "category", "type": "text"},
        {"name": "AnnualPrice", "label": "Annual Price", "from": "annual_price", "type": "number"},
        {"name": "MarginPct", "label": "Margin Pct", "from": "margin_pct", "type": "number"}
      ]
    },
    {
      "id": "customer-ownership",
      "title": "Cross Selling Opportunities Customer Ownership",
      "description": "Synthetic customer ownership (AIBAST Cross-Selling Opportunities workshop; fictional).",
      "record_set": "_CUSTOMER_OWNERSHIP",
      "columns": [
        {"name": "Title", "label": "Customer Ownership", "from": "name", "type": "text"},
        {"name": "CustomerOwnershipId", "label": "Customer Ownership ID", "from": "$key", "type": "text"},
        {"name": "Segment", "label": "Segment", "from": "segment", "type": "text"},
        {"name": "Arr", "label": "Arr", "from": "arr", "type": "number"},
        {"name": "Products", "label": "Products", "from": "products", "type": "text", "encoding": "joined"},
        {"name": "TenureMonths", "label": "Tenure Months", "from": "tenure_months", "type": "number"},
        {"name": "HealthScore", "label": "Health Score", "from": "health_score", "type": "number"},
        {"name": "Contact", "label": "Contact", "from": "contact", "type": "text"},
        {"name": "UsageSignals", "label": "Usage Signals", "from": "usage_signals", "type": "text", "encoding": "joined"},
        {"name": "BuyingSignals", "label": "Buying Signals", "from": "buying_signals", "type": "text", "encoding": "joined"},
        {"name": "BudgetWindow", "label": "Budget Window", "from": "budget_window", "type": "text"}
      ]
    },
    {
      "id": "affinity-rules",
      "title": "Cross Selling Opportunities Affinity Rules",
      "description": "Synthetic affinity rules (AIBAST Cross-Selling Opportunities workshop; fictional).",
      "record_set": "_AFFINITY_RULES",
      "columns": [
        {"name": "Title", "label": "Affinity Rule", "from": "$key", "type": "text"},
        {"name": "AffinityRuleId", "label": "Affinity Rule ID", "from": "$key", "type": "text"},
        {"name": "IfOwns", "label": "If Owns", "from": "if_owns", "type": "text"},
        {"name": "Recommend", "label": "Recommend", "from": "recommend", "type": "text"},
        {"name": "AffinityScore", "label": "Affinity Score", "from": "affinity_score", "type": "number"},
        {"name": "SuccessRate", "label": "Success Rate", "from": "success_rate", "type": "number"},
        {"name": "AvgTimeToCloseDays", "label": "Avg Time To Close Days", "from": "avg_time_to_close_days", "type": "number"}
      ]
    },
    {
      "id": "cross-sell-success-rates",
      "title": "Cross Selling Opportunities Cross Sell Success Rates",
      "description": "Synthetic cross sell success rates (AIBAST Cross-Selling Opportunities workshop; fictional).",
      "record_set": "_CROSS_SELL_SUCCESS_RATES",
      "columns": [
        {"name": "Title", "label": "Cross Sell Success Rate", "from": "$key", "type": "text"},
        {"name": "CrossSellSuccessRateId", "label": "Cross Sell Success Rate ID", "from": "$key", "type": "text"},
        {"name": "AvgSuccessRate", "label": "Avg Success Rate", "from": "avg_success_rate", "type": "number"},
        {"name": "AvgDealCycleDays", "label": "Avg Deal Cycle Days", "from": "avg_deal_cycle_days", "type": "number"},
        {"name": "AvgExpansionPct", "label": "Avg Expansion Pct", "from": "avg_expansion_pct", "type": "number"}
      ]
    }
  ]
}
