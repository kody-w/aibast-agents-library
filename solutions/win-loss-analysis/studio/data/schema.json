{
  "schema": "aibast-studio-data/1.0",
  "solution": "win-loss-analysis",
  "description": "The workshop's synthetic records as SharePoint lists: the same records the portable agent and the knowledge file hold, one list per record set. Every value is fictional.",
  "source": "agents/@aibast-agents-library/b2b_sales_stacks/win_loss_analysis_stack/win_loss_analysis_agent.py",
  "records_markdown": "solutions/win-loss-analysis/manual/knowledge/aibast_win-loss-analysis-synthetic-records.md",
  "lists": [
    {
      "id": "loss-reasons",
      "title": "Win Loss Analysis Loss Reasons",
      "description": "Synthetic loss reasons (AIBAST Win/Loss Analysis workshop; fictional).",
      "record_set": "_LOSS_REASONS",
      "columns": [
        {"name": "Title", "label": "Loss Reason", "from": "$value", "type": "text"},
        {"name": "LossReasonId", "label": "Loss Reason ID", "from": "$key", "type": "text"}
      ]
    },
    {
      "id": "competitors",
      "title": "Win Loss Analysis Competitors",
      "description": "Synthetic competitors (AIBAST Win/Loss Analysis workshop; fictional).",
      "record_set": "_COMPETITORS",
      "columns": [
        {"name": "Title", "label": "Competitor", "from": "$key", "type": "text"},
        {"name": "CompetitorId", "label": "Competitor ID", "from": "$key", "type": "text"},
        {"name": "Strength", "label": "Strength", "from": "strength", "type": "text"},
        {"name": "Weakness", "label": "Weakness", "from": "weakness", "type": "text"}
      ]
    },
    {
      "id": "q3-opportunities",
      "title": "Win Loss Analysis Q3 Opportunities",
      "description": "Synthetic q3 opportunities (AIBAST Win/Loss Analysis workshop; fictional).",
      "record_set": "_Q3_OPPORTUNITIES",
      "columns": [
        {"name": "Title", "label": "Q3 Opportunity", "from": "name", "type": "text"},
        {"name": "Q3OpportunityId", "label": "Q3 Opportunity ID", "from": "$key", "type": "text"},
        {"name": "Account", "label": "Account", "from": "account", "type": "text"},
        {"name": "Value", "label": "Value", "from": "value", "type": "number"},
        {"name": "Outcome", "label": "Outcome", "from": "outcome", "type": "text"},
        {"name": "CompetitorLostTo", "label": "Competitor Lost To", "from": "competitor_lost_to", "type": "text"},
        {"name": "LossReason", "label": "Loss Reason", "from": "loss_reason", "type": "text"},
        {"name": "Segment", "label": "Segment", "from": "segment", "type": "text"},
        {"name": "DealSizeBucket", "label": "Deal Size Bucket", "from": "deal_size_bucket", "type": "text"}
      ]
    },
    {
      "id": "q2-opportunities",
      "title": "Win Loss Analysis Q2 Opportunities",
      "description": "Synthetic q2 opportunities (AIBAST Win/Loss Analysis workshop; fictional).",
      "record_set": "_Q2_OPPORTUNITIES",
      "columns": [
        {"name": "Title", "label": "Q2 Opportunity", "from": "name", "type": "text"},
        {"name": "Q2OpportunityId", "label": "Q2 Opportunity ID", "from": "$key", "type": "text"},
        {"name": "Account", "label": "Account", "from": "account", "type": "text"},
        {"name": "Value", "label": "Value", "from": "value", "type": "number"},
        {"name": "Outcome", "label": "Outcome", "from": "outcome", "type": "text"},
        {"name": "CompetitorLostTo", "label": "Competitor Lost To", "from": "competitor_lost_to", "type": "text"},
        {"name": "LossReason", "label": "Loss Reason", "from": "loss_reason", "type": "text"},
        {"name": "Segment", "label": "Segment", "from": "segment", "type": "text"},
        {"name": "DealSizeBucket", "label": "Deal Size Bucket", "from": "deal_size_bucket", "type": "text"}
      ]
    },
    {
      "id": "interventions",
      "title": "Win Loss Analysis Interventions",
      "description": "Synthetic interventions (AIBAST Win/Loss Analysis workshop; fictional).",
      "record_set": "_INTERVENTIONS",
      "columns": [
        {"name": "Title", "label": "Intervention", "from": "label", "type": "text"},
        {"name": "InterventionId", "label": "Intervention ID", "from": "$key", "type": "text"},
        {"name": "Cost", "label": "Cost", "from": "cost", "type": "number"},
        {"name": "RecoveryRate", "label": "Recovery Rate", "from": "recovery_rate", "type": "number"},
        {"name": "Timeline", "label": "Timeline", "from": "timeline", "type": "text"},
        {"name": "Actions", "label": "Actions", "from": "actions", "type": "text", "encoding": "joined"}
      ]
    }
  ]
}
