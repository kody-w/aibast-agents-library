        {"name": "SyntheticCount", "label": "Synthetic count", "from": "synthetic_count", "type": "text"},
        {"name": "ExactEvidenceBarrier", "label": "Exact evidence barrier", "from": "exact_evidence_barrier", "type": "text"},
        {"name": "ExactDraftHandlingRoute", "label": "Exact draft handling route", "from": "exact_draft_handling_route", "type": "text"}
