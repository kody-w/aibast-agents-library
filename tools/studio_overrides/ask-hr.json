{
  "knowledge_tables": {
    "Fictional employee profiles [headings]": {
      "literal_fields": {
        "Alias": "$key",
        "Leave balance": {
          "fields": ["leave_balance.vacation", "leave_balance.sick", "leave_balance.personal", "leave_balance.accrual_rate"],
          "template": "vacation {0:.1f} days; sick {1:.1f} days; personal {2:.1f} days; accrual {3} days/month"
        },
        "Health plan": "health_plan.plan"
      }
    }
  }
}
