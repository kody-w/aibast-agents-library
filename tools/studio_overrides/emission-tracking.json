{
  "prefix": "Emissions",
  "agent_names": {
    "easy": "Emissions Tracking Studio",
    "manual": "Emissions Studio Manual"
  },
  "opening": "Use only the synthetic records in the workshop's three SharePoint lists, the uploaded rules-and-controls knowledge, and the operation skills. Read facilities with the **Get facility records** tool (list *Emissions Facilities*), offset projects with **Get carbon offset records** (*Emissions Carbon Offsets*) and reporting programs with **Get regulation records** (*Emissions Regulations*).",
  "lists": {
    "FACILITIES": {
      "description": "Synthetic facilities, their scope 1-3 emissions and thresholds (AIBAST Emissions Tracking workshop; fictional).",
      "key_name": "FacilityId",
      "tool": "Get facility records",
      "column_names": {
        "type": "FacilityType",
        "emissions.scope_1.co2_tonnes": "Scope1CO2",
        "emissions.scope_1.ch4_tonnes": "Scope1CH4",
        "emissions.scope_1.n2o_tonnes": "Scope1N2O",
        "emissions.scope_2.co2_tonnes": "Scope2CO2",
        "emissions.scope_2.ch4_tonnes": "Scope2CH4",
        "emissions.scope_2.n2o_tonnes": "Scope2N2O",
        "emissions.scope_3.co2_tonnes": "Scope3CO2",
        "emissions.scope_3.ch4_tonnes": "Scope3CH4",
        "emissions.scope_3.n2o_tonnes": "Scope3N2O",
        "regulatory_threshold_co2": "ThresholdCO2"
      },
      "labels": {
        "name": "Facility",
        "$key": "Facility ID",
        "type": "Type",
        "capacity_mw": "Capacity (MW)",
        "emissions.scope_1.co2_tonnes": "Scope 1 CO2 (t)",
        "emissions.scope_1.ch4_tonnes": "Scope 1 CH4 (t)",
        "emissions.scope_1.n2o_tonnes": "Scope 1 N2O (t)",
        "emissions.scope_2.co2_tonnes": "Scope 2 CO2 (t)",
        "emissions.scope_2.ch4_tonnes": "Scope 2 CH4 (t)",
        "emissions.scope_2.n2o_tonnes": "Scope 2 N2O (t)",
        "emissions.scope_3.co2_tonnes": "Scope 3 CO2 (t)",
        "emissions.scope_3.ch4_tonnes": "Scope 3 CH4 (t)",
        "emissions.scope_3.n2o_tonnes": "Scope 3 N2O (t)",
        "regulatory_threshold_co2": "Regulatory threshold CO2 (t)",
        "reduction_target_pct": "Reduction target (%)",
        "baseline_year": "Baseline year",
        "baseline_co2": "Baseline CO2 (t)"
      }
    },
    "CARBON_OFFSETS": {
      "description": "Synthetic carbon offset projects and available credits (AIBAST Emissions Tracking workshop; fictional).",
      "key_name": "OffsetId",
      "column_names": {"type": "OffsetType"},
      "labels": {
        "project": "Project",
        "$key": "Offset ID",
        "type": "Type",
        "credits_available": "Credits available (t)",
        "price_per_tonne": "Price per tonne ($)",
        "verified_by": "Verified by"
      }
    },
    "REGULATIONS": {
      "description": "Synthetic reporting programs, thresholds and deadlines (AIBAST Emissions Tracking workshop; fictional).",
      "key_name": "RegulationId",
      "labels": {
        "name": "Program",
        "$key": "Regulation ID",
        "threshold_co2": "Reporting threshold CO2 (t)"
      }
    }
  },
  "app": {
    "description": "The Emissions Tracking workshop's synthetic facilities, carbon offset projects and reporting programs, read from its SharePoint lists.",
    "notice": "Synthetic demonstration data: every facility, figure and program is fictional. Nothing here is verified emissions evidence, a compliance determination or a credit purchase.",
    "tables": {
      "facilities": {
        "columns": [
          "FacilityId", "Title", "FacilityType", "Location", "Scope1CO2", "Scope2CO2", "Scope3CO2",
          "TotalCO2", "ThresholdCO2", "PctOfThreshold"
        ],
        "labels": {
          "FacilityId": "ID",
          "Title": "Facility",
          "FacilityType": "Type",
          "Scope1CO2": "Scope 1 CO2 (t)",
          "Scope2CO2": "Scope 2 CO2 (t)",
          "Scope3CO2": "Scope 3 CO2 (t)",
          "TotalCO2": "Total CO2 (t)",
          "ThresholdCO2": "Threshold CO2 (t)",
          "PctOfThreshold": "Scope 1 % of threshold",
          "CapacityMW": "Capacity (MW)",
          "ReductionTargetPct": "Reduction target (%)",
          "BaselineYear": "Baseline year",
          "BaselineCO2": "Baseline CO2 (t)"
        },
        "computed": [
          {"name": "TotalCO2", "sum": ["Scope1CO2", "Scope2CO2", "Scope3CO2"]},
          {"name": "PctOfThreshold", "percent": ["Scope1CO2", "ThresholdCO2"]}
        ],
        "formats": {
          "CapacityMW": "integer",
          "Scope1CO2": "integer",
          "Scope2CO2": "integer",
          "Scope3CO2": "integer",
          "TotalCO2": "integer",
          "ThresholdCO2": "integer",
          "BaselineCO2": "integer",
          "PctOfThreshold": "percent1"
        },
        "metrics": [
          {"label": "Facilities", "op": "count"},
          {"label": "Scope 1 CO2 (t)", "op": "sum", "column": "Scope1CO2"},
          {"label": "Total CO2 (t)", "op": "sum", "column": "TotalCO2"}
        ],
        "groupBy": "FacilityType"
      },
      "carbon-offsets": {
        "title": "Carbon offsets",
        "labels": {
          "OffsetId": "ID",
          "Title": "Project",
          "OffsetType": "Type",
          "CreditsAvailable": "Credits available (t)",
          "PricePerTonne": "Price per tonne",
          "VerifiedBy": "Verified by"
        },
        "formats": {"CreditsAvailable": "integer", "PricePerTonne": "currency", "Vintage": "text"},
        "metrics": [
          {"label": "Projects", "op": "count"},
          {"label": "Credits available (t)", "op": "sum", "column": "CreditsAvailable"}
        ],
        "groupBy": "OffsetType"
      },
      "regulations": {
        "title": "Reporting programs",
        "labels": {"RegulationId": "ID", "Title": "Program", "ThresholdCO2": "Reporting threshold CO2 (t)"},
        "formats": {"ThresholdCO2": "integer"},
        "metrics": [{"label": "Programs", "op": "count"}],
        "sortBy": "Deadline"
      }
    }
  }
}
