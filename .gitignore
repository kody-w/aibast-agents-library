rapp-deployment-outputs.json
rapp_brainstem/.copilot_token
rapp_brainstem/.env
rapp_brainstem/.brainstem_data/
rapp_brainstem/.remote_agents/
rapp_brainstem/voice.zip
rapp_brainstem/voice.json
rapp_brainstem/.pytest_cache/
rapp_brainstem/__pycache__/
rapp_brainstem/agents/__pycache__/
__pycache__/
*.pyc

# Captured browser/session snapshots must never be committed — they embed real
# identities, tenant GUIDs and key material.
tools/tool_assets/
snapshot-*.html

# macOS
.DS_Store
**/.DS_Store

# RAPPVision working footage. B-roll cuts and 1080p masters are intermediates
# regenerated by scripts/cut_broll.py and scripts/render_film.py; only the
# web-optimised films that are actually served get committed.
media/broll/*/
# Generated films — the pipeline is archived; renders stay out of git.
archive/rappvision-pipeline/media/generated-films/*.mp4
media/videos/generated/*.mp4

media/plates/base/
(base tracks stay local — alignment proxies only)

# Showcase film intermediates. work/ is regenerated on every build and dist/
# is the build's own output; film/out/ is what is finished and is committed.
film/projects/*/work/
film/projects/*/dist/
film/.work/
film/.env.local
*.env.local

# Rendered films. Same rule as media/videos/generated: the renders are
# regenerated by film/kit/make.py from the configs, which ARE committed, and
# the per-batch manifest records what each one measured. A 1080p film is not
# a source artifact. Promoting one to something the site serves is a separate,
# human decision.
film/out/*/*.mp4

# Generated video and live-action source assets are not carried here.
# The 48 professional demo recordings under media/videos/ ARE carried.
# They live on the local feature/film-and-video branch; see docs/NO-VIDEO.md.
*.mov
*.caf
film/corpus/videos/
film/assets/broll/
film/assets/audio/
film/assets/stings/
film/projects/*/dist/
film/projects/*/work/
archive/rappvision-pipeline/media/
